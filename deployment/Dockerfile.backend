# Stage 1: Build
FROM node:20-alpine AS builder
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci
COPY backend/ ./
RUN npm run build

# Stage 2: Run
FROM node:20-alpine
WORKDIR /app
COPY backend/package*.json ./
RUN npm ci --only=production
COPY --from=builder /app/dist ./dist

# Create folders for runtime storage
RUN mkdir -p uploads temp

EXPOSE 3001
ENV NODE_ENV=production
CMD ["node", "dist/main"]
