.git
.gitlab-ci.yml
.gitattributes
.gitignore

# Env nhạy cảm (env cụ thể được COPY tường minh trong Dockerfile)
.env
.env.local
.env.staging

# Agent/IDE
AGENTS.md
CLAUDE.md
.claude

# Docker
Dockerfile
.dockerignore
docker-compose*.yml

