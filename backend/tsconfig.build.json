{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "strictFunctionTypes": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "alwaysStrict": false
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "src/scripts", "src/test*", "src/inspect*", "src/debug*", "src/query*", "src/compare*", "src/run*", "src/search*", "src/print*", "src/dump*", "src/detailed-match.ts", "src/trigger*"]
}
