# ==============================================================================
# MXV SHIFT CHECKLIST - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# Lưu ý: Các thông tin tài khoản/mật khẩu được mã hóa và lưu trực tiếp trong CSDL (MongoDB),
# bạn có thể cấu hình trực tiếp trên Web UI tại: https://10.0.0.26/admin/bot-config
# Các biến dưới đây dùng cho mức cấu hình hạ tầng Server / DevOps / CI-CD.

# ── 1. SERVER & DATABASE ──────────────────────────────────────────────────────
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/mxv_shift_checklist
JWT_SECRET=mxv-super-secret-jwt-key-2026
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── 2. ĐƯỜNG DẪN Ổ ĐĨA DỮ LIỆU CHUNG (NETWORK SHARE / MOUNT) ──────────────────
# Linux Mount: /mnt/qlgd-it
# Windows UNC: \\10.0.0.26\qlgd-it
SHARED_STORAGE_PATH=/mnt/qlgd-it
STORAGE_SHARE_WINDOWS=M:\Tailieuchung\QLGD-IT
STORAGE_MOUNT_LINUX=/mnt/qlgd-it

# ── 2.1. DEFAULT BACKUP & STAT PATHS ──────────────────────────────────────────
# Phân hệ MS - CQG:
DEFAULT_BACKUP_PATH_MS=M:\Tailieuchung\QLGD-IT\Quanlygiaodich\Tai lieu hoat dong\Backup MS\Futures
DEFAULT_BACKUP_PATH_CQG=M:\Tailieuchung\QLGD-IT\Quanlygiaodich\Tai lieu hoat dong\Backup CQG\Futures
DEFAULT_BACKUP_PATH_ACM=M:\Tailieuchung\QLGD-IT\Quanlygiaodich\Tai lieu hoat dong\Backup ACM\Futures
BOT_MS_LOT_STAT_PATH=M:\Tailieuchung\QLGD-IT\Quanlygiaodich\Tai lieu hoat dong\Thong ke so lot giao dich
BOT_MS_VALUE_STAT_PATH=M:\Tailieuchung\QLGD-IT\Quanlygiaodich\Tai lieu hoat dong\Thong ke gia tri giao dich

# Phân hệ CoreCCP & CoreEX:
DEFAULT_BACKUP_PATH_CCP=M:\Tailieuchung\QLGD-IT\Quanlygiaodich\Tai lieu hoat dong\Backup CCP\Futures
DEFAULT_BACKUP_PATH_CE=M:\Tailieuchung\QLGD-IT\Quanlygiaodich\Tai lieu hoat dong\Backup CE\Futures
BOT_CCP_STAT_TARGET_ROOT=M:\Tailieuchung\QLGD-IT\Quanlygiaodich\Tai lieu hoat dong\Thong ke ccp

# ── 3. CỔNG KẾT NỐI HỆ THỐNG NGOẠI BỘ (EXTERNAL DOMAINS & PORTS) ──────────────
# M-System (Vendor Newgen)
MS_ADMIN_URL=https://msadmin.mxv.com.vn
MS_BASE_URL=https://msapi.mxv.com.vn

# ACM (Web ETP & Straits Financial SFTP)
ACM_BASE_URL=https://acm-etp.acmmex.com
ACM_SFTP_HOST=sftp.mxv.com.vn
ACM_SFTP_PORT=2231
ACM_SFTP_REMOTE_DIR=/data/

# CoreCCP (Clearing & Settlement)
CORECCP_BASE_URL=https://coreccp.mxv.com.vn

# Core Exchange (CoreEX)
COREEXCHANGE_BASE_URL=https://uat-coreexchange.mxv.com.vn
COREEXCHANGE_CLIENT_ID=web-exchange-mxv

# CQG Web Desktop
CQG_URL_TRADE=https://m.cqg.com/cqg/desktop/logon?ref=forced
CQG_URL_PRICE=https://mdemo.cqg.com/cqg/desktop/logon?ref=forced

# ── 4. AI CAPTCHA SOLVER (GOOGLE GEMINI) ──────────────────────────────────────
GEMINI_API_KEY=
